{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bakulbadwal/ai-frontier-dispatch/schemas/dashboard-issue.schema.json",
  "title": "Dashboard issue",
  "description": "One digest rendered for dashboard/index.html. It is a second view of the markdown digest: every item in the digest appears here.",
  "type": "object",
  "required": ["date", "window", "why", "top", "parts"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "issue_label": {"type": "string"},
    "generated": {"type": "string"},
    "archive": {"type": "string", "description": "Where the markdown digest lives. Shown in the footer."},
    "window": {"type": "string"},
    "excluded": {"type": "string"},
    "why": {"type": "string", "description": "The closing one-line reason this window matters."},
    "top": {
      "type": "array",
      "description": "Ids of the 5-6 most important items across all parts, in reading order.",
      "items": {"type": "string"},
      "minItems": 1,
      "maxItems": 8
    },
    "process_notes": {"type": "array", "items": {"type": "string"}},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "sections"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "title": {"type": "string"},
          "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "body"],
              "properties": {"title": {"type": "string"}, "body": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "short": {"type": "string", "description": "Label in the section navigation."},
        "lede": {"type": "string"},
        "after": {"type": "string"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "table": {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": {"type": "array", "items": {"type": "string"}},
            "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
          }
        },
        "pulse": {
          "type": "object",
          "properties": {
            "tiles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": {"type": "string"},
                  "value": {"type": "string"},
                  "change": {"type": "string", "description": "Starts with + or − to color it."},
                  "note": {"type": "string"}
                }
              }
            },
            "notes": {"type": "string"}
          }
        },
        "tells": {
          "type": "object",
          "description": "Thesis watch rows.",
          "required": ["rows"],
          "properties": {
            "headline": {"type": "string"},
            "verdict": {"type": "string"},
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status", "text"],
                "properties": {
                  "n": {"type": ["integer", "string"]},
                  "name": {"type": "string"},
                  "status": {"enum": ["with", "against", "mixed", "quiet"]},
                  "text": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "title", "score", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string"},
        "dek": {"type": "string"},
        "score": {"type": "integer", "minimum": 0, "maximum": 6, "description": "Pre-filter score 0-5, +1 when two or more independent streams carried the story."},
        "confidence": {"enum": ["verified", "reported", "unverified"]},
        "streams": {"type": "integer", "minimum": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "body": {"type": "string", "description": "Supports **bold**, *italic*, [text](https://...), `code`, '- ' bullet lines, and blank lines between paragraphs."},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}
          }
        }
      }
    }
  }
}
